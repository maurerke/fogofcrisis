# ============================================
# Fog of Crisis — Environment Configuration
# ============================================
# Copy this file to .env and adjust values.
# Do NOT commit .env to version control.

# Server port (default: 3001)
PORT=3001

# Environment: "development" or "production"
NODE_ENV=development

# Admin API key for /api/admin/* endpoints
# REQUIRED in production. Generate with: openssl rand -hex 32
ADMIN_API_KEY=changeme

# Path to scenario JSON file
# SCENARIO_PATH=scenarios/ransomware_stadtwerke.json

# Path to SQLite database file
# DB_PATH=data/cybercrisis.sqlite

# Frontend origin for CORS (production URL)
# FRONTEND_ORIGIN=https://your-domain.example.com

# Reconnect grace period in milliseconds (default: 300000 = 5 minutes)
# RECONNECT_TIMEOUT_MS=300000
